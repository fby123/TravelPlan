/* 路线类型切换 */
.route-type {
  display: flex;
  background-color: white;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.type-btn {
  flex: 1;
  padding: 14rpx;
  border: none;
  background-color: #f5f5f5;
  color: #666;
  font-size: 14px;
}

.type-btn.active {
  background-color: #4A90E2;
  color: white;
}

/* 地图容器 */
.map-container {
  height: 400rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.map {
  width: 100%;
  height: 100%;
}

/* 路线输入 */
.route-input {
  background-color: white;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.input-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.input-label {
  width: 60rpx;
  font-size: 14px;
  color: #666;
}

.input {
  flex: 1;
  padding: 12rpx;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
  font-size: 14px;
}

.location-btn {
  background-color: #f5f5f5;
  border: none;
  border-radius: 6rpx;
  padding: 12rpx;
  margin-left: 12rpx;
}

.location-icon {
  font-size: 16px;
}

.plan-btn {
  width: 100%;
  background-color: #4A90E2;
  color: white;
  border: none;
  border-radius: 6rpx;
  padding: 14rpx;
  font-size: 14px;
  margin-top: 8rpx;
}

/* 路线详情 */
.route-detail {
  background-color: white;
  border-radius: 8rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.detail-title {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-item {
  display: flex;
  align-items: flex-start;
}

.detail-step {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #4A90E2;
  color: white;
  font-size: 12px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.detail-info {
  flex: 1;
  font-size: 14px;
  color: #333;
  line-height: 1.5;
}