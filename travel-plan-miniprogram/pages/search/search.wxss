/* 搜索框样式 */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  background-color: white;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.search-input {
  flex: 1;
  padding: 12rpx;
  font-size: 14px;
  border: none;
  outline: none;
}

.search-btn {
  background-color: #4A90E2;
  color: white;
  border: none;
  border-radius: 6rpx;
  padding: 10rpx 20rpx;
  font-size: 14px;
  margin-left: 12rpx;
}

/* 筛选区域 */
.filter-section {
  background-color: white;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.filter-title {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

.filter-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-label {
  width: 120rpx;
  font-size: 14px;
  color: #666;
}

.picker {
  flex: 1;
  padding: 12rpx;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
  font-size: 14px;
  color: #333;
}

.filter-btn {
  width: 100%;
  background-color: #4A90E2;
  color: white;
  border: none;
  border-radius: 6rpx;
  padding: 14rpx;
  font-size: 14px;
  margin-top: 8rpx;
}

/* 结果区域 */
.result-section {
  background-color: white;
  border-radius: 8rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.result-title {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

/* 攻略列表 */
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.strategy-item {
  display: flex;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  overflow: hidden;
  padding: 12rpx;
}

.strategy-img {
  width: 140rpx;
  height: 100rpx;
  object-fit: cover;
  border-radius: 6rpx;
}

.strategy-info {
  flex: 1;
  padding: 0 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.strategy-title {
  font-size: 14px;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.strategy-meta {
  font-size: 12px;
  color: #666;
  margin-bottom: 8rpx;
}

.strategy-desc {
  font-size: 12px;
  color: #999;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 无结果提示 */
.no-result {
  text-align: center;
  padding: 64rpx 0;
  color: #999;
  font-size: 14px;
}