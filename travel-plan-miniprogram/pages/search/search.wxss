/* 搜索框样式 */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 12rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: var(--white);
  border-radius: 12rpx;
  padding: 0 16rpx;
  box-shadow: var(--shadow);
  height: 80rpx;
}

.search-icon {
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 14px;
  border: none;
  outline: none;
  height: 100%;
  color: var(--text-primary);
}

.search-placeholder {
  color: var(--text-light);
}

.search-btn {
  background-color: var(--primary-color);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 0 32rpx;
  font-size: 14px;
  font-weight: 500;
  height: 80rpx;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
}

.search-btn:hover {
  background-color: var(--primary-dark);
  transform: translateY(-1rpx);
  box-shadow: var(--shadow-hover);
}

.search-btn.touch-feedback:active {
  transform: scale(0.98);
}

/* 筛选区域 */
.filter-section {
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
}

.filter-section:hover {
  box-shadow: var(--shadow-hover);
}

.filter-title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--text-primary);
}

.filter-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-label {
  width: 120rpx;
  font-size: 14px;
  color: var(--text-secondary);
}

.picker {
  flex: 1;
  padding: 14rpx 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 14px;
  color: var(--text-primary);
  transition: all 0.3s ease;
}

.picker:hover {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3rpx var(--primary-light);
}

.filter-btn {
  width: 100%;
  background-color: var(--primary-color);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 14px;
  font-weight: 500;
  margin-top: 8rpx;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
}

.filter-btn:hover {
  background-color: var(--primary-dark);
  transform: translateY(-1rpx);
  box-shadow: var(--shadow-hover);
}

.filter-btn.touch-feedback:active {
  transform: scale(0.98);
}

/* 结果区域 */
.result-section {
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
}

.result-section:hover {
  box-shadow: var(--shadow-hover);
}

.result-title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text-primary);
}

/* 攻略列表 */
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.strategy-item {
  display: flex;
  background-color: var(--white);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.strategy-item:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-hover);
}

.strategy-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.strategy-item:hover::before {
  left: 100%;
}

.strategy-img {
  width: 200rpx;
  height: 150rpx;
  object-fit: cover;
}

.strategy-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.strategy-title {
  font-size: 16px;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.strategy-meta {
  font-size: 12px;
  color: var(--text-light);
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.strategy-meta .meta-divider {
  margin: 0 8rpx;
  color: var(--text-light);
}

.strategy-desc {
  font-size: 12px;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

/* 无结果提示 */
.no-result {
  text-align: center;
  padding: 64rpx 0;
  color: var(--text-light);
  font-size: 14px;
}

/* 动画效果 */
.fade-in {
  opacity: 0;
  transform: translateY(20rpx);
  animation: fadeIn 0.6s ease forwards;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .search-bar {
    margin-bottom: 20rpx;
  }
  
  .filter-section,
  .result-section {
    padding: 16rpx;
  }
  
  .strategy-img {
    width: 160rpx;
    height: 120rpx;
  }
  
  .strategy-info {
    padding: 16rpx;
  }
}

/* 深色模式支持 */
@media (prefers-color-scheme: dark) {
  .strategy-item {
    background-color: var(--white);
  }
}