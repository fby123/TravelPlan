/* 攻略标题 */
.strategy-header {
  background-color: white;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.strategy-title {
  font-size: 20px;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.strategy-meta {
  font-size: 14px;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.strategy-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border: none;
  border-radius: 6rpx;
  padding: 10rpx 16rpx;
  font-size: 14px;
  color: #333;
}

.action-icon {
  margin-right: 6rpx;
  font-size: 16px;
}

/* 区域样式 */
.section {
  background-color: white;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

/* 每日行程 */
.day-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.day-item {
  border-left: 2rpx solid #4A90E2;
  padding-left: 16rpx;
}

.day-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.day-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.activity-item {
  display: flex;
  align-items: flex-start;
}

.activity-dot {
  color: #4A90E2;
  margin-right: 8rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.activity-text {
  flex: 1;
  font-size: 14px;
  color: #333;
  line-height: 1.5;
}

/* 景点介绍 */
.attraction-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.attraction-item {
  display: flex;
  gap: 16rpx;
}

.attraction-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 6rpx;
  object-fit: cover;
}

.attraction-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.attraction-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.attraction-desc {
  font-size: 14px;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.attraction-info-text {
  font-size: 12px;
  color: #999;
  margin-bottom: 4rpx;
  display: block;
}

/* 餐饮推荐 */
.food-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.food-item {
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 6rpx;
}

.food-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.food-desc {
  font-size: 14px;
  color: #666;
  display: block;
}

/* 注意事项 */
.notes {
  font-size: 14px;
  color: #666;
  line-height: 1.5;
  white-space: pre-wrap;
}