<view class="container">
  <!-- 顶部banner -->
  <view class="banner">
    <image class="banner-img" src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=travel%20banner%20with%20mountains%20and%20ocean&image_size=landscape_16_9" mode="aspectFill"></image>
    <view class="banner-content">
      <text class="banner-title">发现精彩旅程</text>
      <text class="banner-subtitle">探索世界各地的旅游攻略</text>
    </view>
  </view>
  
  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <icon class="search-icon" type="search" size="24" color="#999"></icon>
      <input 
        class="search-input" 
        placeholder="输入目的地检索攻略" 
        placeholder-class="search-placeholder"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
    </view>
    <button class="search-btn touch-feedback" bindtap="onSearch">搜索</button>
  </view>
  
  <!-- 热门推荐 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">热门推荐</text>
      <text class="section-more touch-feedback" bindtap="viewMore">查看更多</text>
    </view>
    <view class="recommend-list">
      <view class="recommend-item fade-in touch-feedback" wx:for="{{hotDestinations}}" wx:key="index" bindtap="goToDetail" style="animation-delay: {{index * 0.1}}s;">
        <image class="recommend-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="recommend-info">
          <text class="recommend-title">{{item.title}}</text>
          <text class="recommend-desc">{{item.desc}}</text>
          <view class="recommend-tag">
            <text class="tag">{{item.tag}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 功能入口 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">核心功能</text>
    </view>
    <view class="feature-list">
      <view class="feature-item fade-in touch-feedback" bindtap="goToGenerate" style="animation-delay: 0.1s;">
        <view class="feature-icon generate-icon">
          <image class="feature-icon-img" src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=generate%20icon%20simple%20blue&image_size=square" mode="aspectFit"></image>
        </view>
        <text class="feature-text">生成攻略</text>
      </view>
      <view class="feature-item fade-in touch-feedback" bindtap="goToRoute" style="animation-delay: 0.2s;">
        <view class="feature-icon route-icon">
          <image class="feature-icon-img" src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=route%20map%20icon%20simple%20blue&image_size=square" mode="aspectFit"></image>
        </view>
        <text class="feature-text">路线规划</text>
      </view>
      <view class="feature-item fade-in touch-feedback" bindtap="goToCollection" style="animation-delay: 0.3s;">
        <view class="feature-icon collection-icon">
          <image class="feature-icon-img" src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=collection%20star%20icon%20simple%20blue&image_size=square" mode="aspectFit"></image>
        </view>
        <text class="feature-text">我的收藏</text>
      </view>
      <view class="feature-item fade-in touch-feedback" bindtap="goToProfile" style="animation-delay: 0.4s;">
        <view class="feature-icon profile-icon">
          <image class="feature-icon-img" src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=profile%20user%20icon%20simple%20blue&image_size=square" mode="aspectFit"></image>
        </view>
        <text class="feature-text">个人中心</text>
      </view>
    </view>
  </view>
  
  <!-- 热门攻略 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">热门攻略</text>
      <text class="section-more touch-feedback" bindtap="viewMoreStrategies">查看更多</text>
    </view>
    <view class="strategy-list">
      <view class="strategy-item fade-in touch-feedback" wx:for="{{hotStrategies}}" wx:key="index" bindtap="goToStrategyDetail" style="animation-delay: {{index * 0.1 + 0.2}}s;">
        <image class="strategy-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="strategy-info">
          <text class="strategy-title">{{item.title}}</text>
          <text class="strategy-desc">{{item.desc}}</text>
          <view class="strategy-meta">
            <text class="meta-item">{{item.days}}天</text>
            <text class="meta-divider">|</text>
            <text class="meta-item">{{item.people}}</text>
            <text class="meta-divider">|</text>
            <text class="meta-item">{{item.views}}浏览</text>
            <text class="meta-tag">{{item.level}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 页面加载动画 -->
  <view class="page-loading" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>