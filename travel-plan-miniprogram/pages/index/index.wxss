/* 顶部banner */
.banner {
  position: relative;
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.banner-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.banner-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  color: white;
}

.banner-title {
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.banner-subtitle {
  font-size: 14px;
  opacity: 0.9;
}

/* 搜索框样式 */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  gap: 12rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: var(--white);
  border-radius: 12rpx;
  padding: 0 16rpx;
  box-shadow: var(--shadow);
  height: 80rpx;
}

.search-icon {
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 14px;
  border: none;
  outline: none;
  height: 100%;
  color: var(--text-primary);
}

.search-placeholder {
  color: var(--text-light);
}

.search-btn {
  background-color: var(--primary-color);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 0 32rpx;
  font-size: 14px;
  font-weight: 500;
  height: 80rpx;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
}

.search-btn:hover {
  background-color: var(--primary-dark);
  transform: translateY(-1rpx);
  box-shadow: var(--shadow-hover);
}

/* 区域标题 */
.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: 14px;
  color: var(--primary-color);
  cursor: pointer;
}

.section-more:hover {
  color: var(--primary-dark);
  text-decoration: underline;
}

/* 热门推荐列表 */
.recommend-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.recommend-item {
  background-color: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
  position: relative;
}

.recommend-item:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-hover);
}

.recommend-img {
  width: 100%;
  height: 140rpx;
  object-fit: cover;
}

.recommend-info {
  padding: 16rpx;
}

.recommend-title {
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 8rpx;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend-desc {
  font-size: 12px;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.recommend-tag {
  display: inline-block;
}

.tag {
  font-size: 10px;
  padding: 2rpx 8rpx;
  background-color: var(--primary-light);
  color: var(--primary-color);
  border-radius: 10rpx;
}

/* 功能入口列表 */
.feature-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
}

.feature-item:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-hover);
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.generate-icon {
  background-color: var(--primary-light);
}

.route-icon {
  background-color: var(--accent-light);
}

.collection-icon {
  background-color: var(--secondary-light);
}

.profile-icon {
  background-color: #F3E5F5;
}

.feature-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.feature-text {
  font-size: 14px;
  color: var(--text-primary);
  text-align: center;
}

/* 热门攻略列表 */
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.strategy-item {
  display: flex;
  background-color: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
}

.strategy-item:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-hover);
}

.strategy-img {
  width: 200rpx;
  height: 150rpx;
  object-fit: cover;
}

.strategy-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.strategy-title {
  font-size: 16px;
  font-weight: 500;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.strategy-desc {
  font-size: 12px;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.strategy-meta {
  display: flex;
  align-items: center;
  font-size: 12px;
  color: var(--text-light);
}

.meta-item {
  margin-right: 8rpx;
}

.meta-divider {
  margin: 0 8rpx;
  color: var(--text-light);
}

.meta-tag {
  margin-left: auto;
  padding: 2rpx 12rpx;
  background-color: var(--secondary-light);
  color: var(--secondary-color);
  border-radius: 10rpx;
  font-size: 10px;
  font-weight: 500;
}

/* 动画延迟 */
.fade-in {
  opacity: 0;
  transform: translateY(20rpx);
  animation: fadeIn 0.6s ease forwards;
}

/* 页面加载动画 */
.page-loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--white);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.page-loading .loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid var(--border);
  border-top: 8rpx solid var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

.page-loading .loading-text {
  font-size: 16px;
  color: var(--text-primary);
}

/* 滚动效果 */
::-webkit-scrollbar {
  width: 4rpx;
  height: 4rpx;
}

::-webkit-scrollbar-track {
  background: var(--background);
}

::-webkit-scrollbar-thumb {
  background: var(--primary-light);
  border-radius: 2rpx;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--primary-color);
}

/* 点击反馈效果 */
.touch-feedback {
  position: relative;
  overflow: hidden;
}

.touch-feedback:active {
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

.touch-feedback::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.1);
  transform: translate(-50%, -50%);
  transition: width 0.3s ease, height 0.3s ease;
}

.touch-feedback:active::after {
  width: 300rpx;
  height: 300rpx;
}

/* 卡片悬停效果增强 */
.recommend-item, .feature-item, .strategy-item {
  position: relative;
  overflow: hidden;
}

.recommend-item::before, .feature-item::before, .strategy-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.recommend-item:hover::before, .feature-item:hover::before, .strategy-item:hover::before {
  left: 100%;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .recommend-list {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .feature-list {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .strategy-img {
    width: 160rpx;
    height: 120rpx;
  }
  
  .banner {
    height: 200rpx;
  }
  
  .banner-title {
    font-size: 20px;
  }
  
  .search-bar {
    margin-bottom: 24rpx;
  }
  
  .section {
    margin-bottom: 24rpx;
  }
}

/* 横屏适配 */
@media (orientation: landscape) {
  .banner {
    height: 180rpx;
  }
  
  .recommend-list {
    grid-template-columns: repeat(4, 1fr);
  }
  
  .feature-list {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* 深色模式支持 */
@media (prefers-color-scheme: dark) {
  page {
    --text-primary: #ffffff;
    --text-secondary: #b0b0b0;
    --text-light: #808080;
    --background: #1a1a1a;
    --white: #2a2a2a;
    --border: #3a3a3a;
    --shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
    --shadow-hover: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  }
  
  .banner-content {
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.9));
  }
}