<view class="container">
  <!-- 个人信息 -->
  <view class="user-info">
    <image class="avatar" src="{{userInfo.avatarUrl || ''}}"></image>
    <view class="user-details">
      <text class="nickname">{{userInfo.nickName || '未登录'}}</text>
      <text class="bio">{{userInfo.bio || '这个人很懒，什么都没写'}}</text>
    </view>
    <button class="login-btn" wx:if="!userInfo.nickName" bindtap="login">登录</button>
  </view>
  
  <!-- 功能入口 -->
  <view class="section">
    <text class="section-title">我的攻略</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToMyStrategies">
        <text class="menu-icon">📝</text>
        <text class="menu-text">我的攻略</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goToCollection">
        <text class="menu-icon">⭐</text>
        <text class="menu-text">我的收藏</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goToHistory">
        <text class="menu-icon">🕒</text>
        <text class="menu-text">历史搜索</text>
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>
  
  <view class="section">
    <text class="section-title">设置</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="clearCache">
        <text class="menu-icon">🗑️</text>
        <text class="menu-text">清除缓存</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="goToFeedback">
        <text class="menu-icon">💬</text>
        <text class="menu-text">意见反馈</text>
        <text class="menu-arrow">→</text>
      </view>
      <view class="menu-item" bindtap="logout" wx:if="userInfo.nickName">
        <text class="menu-icon">🚪</text>
        <text class="menu-text">退出登录</text>
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>
</view>