/* 全局样式 */
page {
  --primary-color: #4A90E2;
  --primary-light: #E3F2FD;
  --primary-dark: #357ABD;
  --secondary-color: #FF9500;
  --secondary-light: #FFF3E0;
  --accent-color: #4CAF50;
  --accent-light: #E8F5E9;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --background: #f8f9fa;
  --white: #ffffff;
  --border: #e0e0e0;
  --shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  --shadow-hover: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  color: var(--text-primary);
  background-color: var(--background);
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.container {
  padding: 16rpx;
}

/* 标题样式 */
h1 {
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 16rpx;
  color: var(--text-primary);
  line-height: 1.2;
}

h2 {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text-primary);
  line-height: 1.3;
}

/* 按钮样式 */
.btn {
  display: inline-block;
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  font-size: 14px;
  font-weight: 500;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.btn-primary {
  background-color: var(--primary-color);
  color: white;
  box-shadow: var(--shadow);
}

.btn-primary:hover {
  background-color: var(--primary-dark);
  transform: translateY(-1rpx);
  box-shadow: var(--shadow-hover);
}

.btn-secondary {
  background-color: var(--white);
  color: var(--text-primary);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow);
}

.btn-secondary:hover {
  border-color: var(--primary-color);
  transform: translateY(-1rpx);
  box-shadow: var(--shadow-hover);
}

/* 卡片样式 */
.card {
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
}

.card:hover {
  box-shadow: var(--shadow-hover);
  transform: translateY(-2rpx);
}

/* 输入框样式 */
.input {
  width: 100%;
  padding: 14rpx 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 14px;
  margin-bottom: 16rpx;
  transition: all 0.3s ease;
}

.input:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3rpx var(--primary-light);
}

/* 加载动画 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
}

.loading::after {
  content: '';
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--border);
  border-top: 4rpx solid var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 错误提示 */
.error {
  color: #ff4d4f;
  font-size: 12px;
  margin-top: 8rpx;
}

/* 成功提示 */
.success {
  color: var(--accent-color);
  font-size: 12px;
  margin-top: 8rpx;
}

/* 动画效果 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.5s ease forwards;
}

/* 渐变背景 */
.gradient-bg {
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  color: white;
}

/* 阴影效果 */
.elevation-1 {
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.elevation-2 {
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.12);
}

.elevation-3 {
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.14);
}