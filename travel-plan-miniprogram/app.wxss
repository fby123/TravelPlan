/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  color: #333;
  background-color: #f5f5f5;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.container {
  padding: 16rpx;
}

/* 标题样式 */
h1 {
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

h2 {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #333;
}

/* 按钮样式 */
.btn {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 14px;
  font-weight: 500;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-primary {
  background-color: #4A90E2;
  color: white;
}

.btn-primary:hover {
  background-color: #357ABD;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
  border: 1rpx solid #ddd;
}

/* 卡片样式 */
.card {
  background-color: white;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 输入框样式 */
.input {
  width: 100%;
  padding: 12rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 14px;
  margin-bottom: 16rpx;
}

/* 加载动画 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
}

/* 错误提示 */
.error {
  color: #ff4d4f;
  font-size: 12px;
  margin-top: 8rpx;
}

/* 成功提示 */
.success {
  color: #52c41a;
  font-size: 12px;
  margin-top: 8rpx;
}